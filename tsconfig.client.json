{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "jsx": "react", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": true, "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["client/**/*.ts", "client/**/*.tsx"]
}
